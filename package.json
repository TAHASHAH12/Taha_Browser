{
  "name": "taha-browser",
  "productName": "Taha",
  "version": "0.1.0",
  "description": "Taha — a Chromium-based web browser built on Electron",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Taha",
  "license": "MIT",
  "build": {
    "appId": "com.taha.browser",
    "productName": "Taha",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
